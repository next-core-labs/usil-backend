# يوصل — متغيرات التشغيل المحلية

# جلسة الكوكي. على الإنتاج يُضبط تلقائياً من PUBLIC_SITE_URL
# COOKIE_SECURE=1
# COOKIE_DOMAIN=.usil.app
PUBLIC_SITE_URL=https://usil.app
APP_URL=https://usil.app
# عنوان IP للعميل (لحدود المحاولات). الإنتاج: Cloudflare ← Caddy ← node.
# إن لم يُضبط: على الإنتاج يُقرأ cf-connecting-ip، وخارج الإنتاج عنوان اتصال TCP.
# اضبطه فقط على هيدر يكتبه البروكسي الموثوق ويستبدله دائماً (مثل cf-connecting-ip أو x-real-ip).
# لا تضعه x-forwarded-for: قيمته الأولى يتحكم بها المتصل فيتجاوز حدود المحاولات.
# ملاحظة: يجب أن يقبل الخادم الأصلي الاتصال من Cloudflare فقط، وإلا يستطيع أي أحد إرسال cf-connecting-ip بنفسه.
# CLIENT_IP_HEADER=cf-connecting-ip
# ويبهوك ميسر — يجب أن يكون HTTPS على نطاق يوصل. على الإنتاج: hooks.usil.app (DNS only في Cloudflare).
MOYASAR_WEBHOOK_URL=https://hooks.usil.app/api/payments/webhook

# توكن Cloudflare بصلاحية Zone.DNS Edit (واختياري Zone.WAF Edit) لتشغيل scripts/connect-cloudflare.py
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# ORIGIN_IP=8.213.85.166

# Clerk غير مستخدم في هذا التطبيق (Express). لا تضف مفاتيح Clerk.
# --- مُيسّر (Moyasar) ---
# المفتاح السري — من لوحة تحكم ميسر. لا يُرفع للريبو أبداً.
# المصادقة Basic: اسم المستخدم sk_live_ أو sk_test_ وكلمة المرور فارغة.
MOYASAR_SECRET_KEY=
# نفس المفتاح السري — اسم بديل يقرأه التطبيق إن وُجد بدل MOYASAR_SECRET_KEY
# PAYMENT_PROVIDER_SECRET_KEY=
# اختياري: لنموذج البطاقة داخل الصفحة إن احتجته لاحقاً
MOYASAR_PUBLISHABLE_KEY=
# سر الويبهوك — نص عشوائي تختاره أنت، وتضعه نفسه عند تسجيل الويبهوك في ميسر.
MOYASAR_WEBHOOK_SECRET=

# بريد اختياري لتأكيد الحساب
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=يوصل <no-reply@usil.app>
