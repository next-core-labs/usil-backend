# يوصل — متغيرات التشغيل المحلية

# جلسة الكوكي. على الإنتاج يُضبط تلقائياً من PUBLIC_SITE_URL
# COOKIE_SECURE=1
# COOKIE_DOMAIN=.usil.app
PUBLIC_SITE_URL=https://usil.app
APP_URL=https://usil.app
# عنوان IP للعميل (لحدود المحاولات). الإنتاج: Cloudflare Workers.
# إن لم يُضبط: على الإنتاج يُقرأ cf-connecting-ip، وخارج الإنتاج عنوان اتصال TCP.
# اضبطه فقط على هيدر يكتبه البروكسي الموثوق ويستبدله دائماً (مثل cf-connecting-ip أو x-real-ip).
# لا تضعه x-forwarded-for: قيمته الأولى يتحكم بها المتصل فيتجاوز حدود المحاولات.
# ملاحظة: يجب أن يقبل الخادم الأصلي الاتصال من Cloudflare فقط، وإلا يستطيع أي أحد إرسال cf-connecting-ip بنفسه.
# CLIENT_IP_HEADER=cf-connecting-ip
# ويبهوك ميسر — يجب أن يكون HTTPS على نطاق يوصل. على الإنتاج: hooks.usil.app (نطاق مخصص على Worker الباكند، مع إيقاف Bot Fight Mode).
MOYASAR_WEBHOOK_URL=https://hooks.usil.app/api/payments/webhook

# توكن Cloudflare بصلاحية Zone.DNS Edit (واختياري Zone.WAF Edit) لتشغيل scripts/connect-cloudflare.py
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# ORIGIN_IP=8.213.85.166

# Clerk غير مستخدم في هذا التطبيق (Express). لا تضف مفاتيح Clerk.
# --- مُيسّر (Moyasar) ---
# المفتاح السري — من لوحة تحكم ميسر. لا يُرفع للريبو أبداً.
# المصادقة Basic: اسم المستخدم sk_live_ أو sk_test_ وكلمة المرور فارغة.
MOYASAR_SECRET_KEY=
# نفس المفتاح السري — اسم بديل يقرأه التطبيق إن وُجد بدل MOYASAR_SECRET_KEY
# PAYMENT_PROVIDER_SECRET_KEY=
# اختياري: لنموذج البطاقة داخل الصفحة إن احتجته لاحقاً
MOYASAR_PUBLISHABLE_KEY=
# سر الويبهوك — نص عشوائي تختاره أنت، وتضعه نفسه عند تسجيل الويبهوك في ميسر.
MOYASAR_WEBHOOK_SECRET=

# --- البريد عبر Resend — رمز تأكيد التسجيل، استعادة الحساب، إشعارات طلبات الموردين ---
# المفتاح من resend.com ← API Keys (صلاحية Sending access تكفي). لا يُرفع للريبو أبداً.
# RESEND_API_KEY=
# المرسل: يجب أن يكون نطاقه موثّقاً في Resend ← Domains (افتراضياً usil.app).
# MAIL_FROM=يوصل <noreply@usil.app>
# رابط لوحة المورّد في رسالة اعتماد الطلب (افتراضياً PUBLIC_SITE_URL)
# VENDOR_CONSOLE_URL=

# بديل اختياري لـ Resend: خادم SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=يوصل <no-reply@usil.app>

# --- واتساب (WhatsApp) — المزوّد: Meta مباشرة أو Kapso ---
# WHATSAPP_PROVIDER=meta        # القيمة الافتراضية. ضعها kapso للتوجيه عبر Kapso.
# رقم واتساب (Phone Number ID) ومعرّف حساب الأعمال (WABA) — أرقام فقط.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# عنوان دومين عام يستقبل الويبهوك (HTTPS). مثال: https://hooks.usil.app
# WHATSAPP_WEBHOOK_URL=

# وضع Meta المباشر:
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=        # يُولَّد تلقائياً إن تُرك فارغاً

# وضع Kapso (WHATSAPP_PROVIDER=kapso):
# مفتاح المشروع من Kapso ← Integrations › API keys (يُرسل كترويسة X-API-Key).
# KAPSO_API_KEY=
# سر الويبهوك — نص عشوائي تختاره أنت، ويُسجَّل نفسه عند إنشاء ويبهوك Kapso.
# KAPSO_WEBHOOK_SECRET=
# افتراضياً يوجّه إلى بروكسي Kapso؛ لا داعي لتغييرها عادةً:
# WHATSAPP_GRAPH_BASE=https://api.kapso.ai/meta/whatsapp
# WHATSAPP_GRAPH_VERSION=v24.0
